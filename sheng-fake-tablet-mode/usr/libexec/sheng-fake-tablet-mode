#!/usr/bin/python3
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 mumuxiao722 <zy349931@163.com>
# sheng-fake-tablet-mode - expose SW_TABLET_MODE to GNOME deterministically and
# control cover blanking via mutter D-Bus PowerSaveMode.
#
# Adapted from the NixOS implementation in DotRedstone/nixos-sheng:
#   nixos/hardware/xiaomi-sheng/sensors/default.nix  (systemd.services.fake-tablet-mode)
#   docs/hall-sensor-rotation.md
#
# Rationale: mutter keys auto-rotation to touch-mode. With the physical
# gpio-keys hall sensor present AND SW_TABLET_MODE=0, mutter locks into
# "laptop" posture and permanently disables auto-rotation. This service:
#   1. hides the physical gpio-keys switch from libinput (udev rule), then
#   2. creates a virtual input device reporting ONLY SW_TABLET_MODE, and
#   3. reports SW_TABLET_MODE=1 only AFTER the real graphical user session
#      starts (explicit 0->1 transition), which unlocks mutter auto-rotation.
# Cover close/open blanking is handled here via org.gnome.Mutter.DisplayConfig
# PowerSaveMode (3 = blank, 0 = on).

import evdev
import subprocess
import sys
import time
import signal
import os
import threading

from evdev import ecodes, UInput

LOGINCTL = "/usr/bin/loginctl"
BUSCTL = "/usr/bin/busctl"
RUNUSER = "/usr/sbin/runuser"
ID = "/usr/bin/id"

# Keep a global reference so the UInput device survives garbage collection.
_ui = None


def log(msg):
    print(f"sheng-fake-tablet-mode: {msg}", file=sys.stderr, flush=True)


def get_real_lid_device():
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
            caps = dev.capabilities()
            if dev.name == "gpio-keys":
                if ecodes.EV_SW in caps and ecodes.SW_LID in caps[ecodes.EV_SW]:
                    return dev
        except Exception:
            continue
    return None


def find_active_session(user_only=False):
    """Return (uid, username) of the active graphical session; skip GDM
    greeter when user_only=True."""
    try:
        out = subprocess.check_output(
            [LOGINCTL, "list-sessions", "--no-legend"],
            text=True, timeout=5)
        for line in out.strip().split("\n"):
            parts = line.split()
            if len(parts) < 2:
                continue
            session_id = parts[0]
            try:
                state = subprocess.check_output(
                    [LOGINCTL, "show-session", session_id, "-p", "Active", "--value"],
                    text=True, timeout=5).strip()
                session_class = subprocess.check_output(
                    [LOGINCTL, "show-session", session_id, "-p", "Class", "--value"],
                    text=True, timeout=5).strip()
                session_type = subprocess.check_output(
                    [LOGINCTL, "show-session", session_id, "-p", "Type", "--value"],
                    text=True, timeout=5).strip()
                graphical = session_type in ("wayland", "x11")
                allowed_class = session_class == "user" or (
                    not user_only and session_class == "greeter")
                if state == "yes" and graphical and allowed_class:
                    uid = subprocess.check_output(
                        [LOGINCTL, "show-session", session_id, "-p", "User", "--value"],
                        text=True, timeout=5).strip()
                    username = subprocess.check_output(
                        [ID, "-un", uid], text=True, timeout=5).strip()
                    return (uid, username)
            except Exception:
                continue
    except Exception:
        pass
    return None


def set_power_save_mode(uid, username, mode):
    """Set mutter PowerSaveMode for a given user session (3=blank, 0=on)."""
    bus = f"unix:path=/run/user/{uid}/bus"
    try:
        subprocess.run(
            [RUNUSER, "-u", username, "--",
             "env", f"DBUS_SESSION_BUS_ADDRESS={bus}",
             BUSCTL, "--user", "set-property",
             "org.gnome.Mutter.DisplayConfig",
             "/org/gnome/Mutter/DisplayConfig",
             "org.gnome.Mutter.DisplayConfig",
             "PowerSaveMode", "i", str(mode)],
            timeout=5, capture_output=True)
        log(f"set PowerSaveMode={mode}")
    except Exception as e:
        log(f"WARNING: failed to set PowerSaveMode: {e}")


def wait_for_sensor_proxy():
    while True:
        try:
            subprocess.check_call(
                [BUSCTL, "status", "net.hadess.SensorProxy"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        except Exception:
            time.sleep(2)


def toggle_tablet_mode(ui):
    """Background thread: after session + sensor are up, do the 0->1 jump."""
    log("waiting for iio-sensor-proxy to own D-Bus name...")
    wait_for_sensor_proxy()
    log("waiting for active user session...")
    while find_active_session(user_only=True) is None:
        time.sleep(2)
    log("session+sensor ready, waiting 5s for Mutter/libinput init...")
    time.sleep(5)
    ui.write(ecodes.EV_SW, ecodes.SW_TABLET_MODE, 1)
    ui.syn()
    log("toggled SW_TABLET_MODE=1")


def main():
    global _ui

    real_dev = None
    for _ in range(30):
        real_dev = get_real_lid_device()
        if real_dev is not None:
            break
        time.sleep(1)
    if real_dev is None:
        log("FATAL: real gpio-keys lid device not found")
        sys.exit(1)
    log(f"found real lid device at {real_dev.path}")

    if os.geteuid() != 0:
        log("FATAL: must run as root (UInput needs it)")
        sys.exit(1)

    cap = {
        ecodes.EV_SW: [ecodes.SW_TABLET_MODE],
        ecodes.EV_KEY: [ecodes.KEY_WAKEUP],
    }
    try:
        _ui = UInput(cap, name="Fake Tablet Mode Switch",
                     vendor=0x1234, product=0x5678)
    except Exception as e:
        log(f"FATAL: cannot create uinput device: {e}")
        sys.exit(1)

    _ui.write(ecodes.EV_SW, ecodes.SW_TABLET_MODE, 0)
    _ui.syn()
    log("initialized SW_TABLET_MODE=0 (no lid exposed)")

    def shutdown(sig, frame):
        log("shutting down")
        if _ui:
            _ui.close()
        sys.exit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    t = threading.Thread(target=toggle_tablet_mode, args=(_ui,), daemon=True)
    t.start()

    try:
        for event in real_dev.read_loop():
            if event.type == ecodes.EV_SW and event.code == ecodes.SW_LID:
                session = find_active_session()
                if session:
                    uid, username = session
                    if event.value == 1:
                        log("lid closed, blanking screen")
                        set_power_save_mode(uid, username, 3)
                    else:
                        log("lid opened, waking and unblanking screen")
                        _ui.write(ecodes.EV_KEY, ecodes.KEY_WAKEUP, 1)
                        _ui.syn()
                        time.sleep(0.01)
                        _ui.write(ecodes.EV_KEY, ecodes.KEY_WAKEUP, 0)
                        _ui.syn()
                        time.sleep(0.3)
                        set_power_save_mode(uid, username, 0)
                else:
                    log(f"lid event={event.value} but no active session")
    except Exception as e:
        log(f"FATAL: error in event read loop: {e}")
        _ui.close()
        sys.exit(1)


if __name__ == "__main__":
    main()