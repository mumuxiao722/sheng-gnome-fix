# Present the virtual tablet-mode switch before the graphical session starts
[Unit]
Description=Fake tablet-mode switch for GNOME auto-rotation (Xiaomi Pad 6S Pro)
After=systemd-modules-load.service
Before=gdm.service
ConditionPathExists=/dev/uinput

[Service]
Type=simple
ExecStart=/usr/libexec/sheng-fake-tablet-mode
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=multi-user.target